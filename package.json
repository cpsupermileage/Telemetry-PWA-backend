{
	"name": "Telemetry-PWA-backend",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"dev": "tsx --watch src/index.ts",
		"start": "node dist/src/index.js",
		"build": "tsc",
		"type-check": "tsc --noEmit",
		"lint": "eslint --cache .",
		"lint:fix": "eslint --cache --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "echo \"Error: no test specified\" && exit 1",
		"prepare": "husky",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --cache --fix",
			"prettier --write"
		],
		"*.{json,yml,yaml,md}": [
			"prettier --write"
		]
	},
	"keywords": [],
	"author": "1withspaghetti",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.11.0",
	"dependencies": {
		"@electric-sql/client": "^1.0.14",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.44.7",
		"drizzle-zod": "^0.8.3",
		"express": "^5.1.0",
		"pg": "^8.16.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@tsconfig/node22": "^22.0.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^24.8.1",
		"@types/pg": "^8.15.5",
		"drizzle-kit": "^0.31.5",
		"eslint": "^9.38.0",
		"eslint-plugin-perfectionist": "^4.15.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.4",
		"prettier": "^3.6.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1"
	},
	"imports": {
		"#*": "./src/*"
	}
}

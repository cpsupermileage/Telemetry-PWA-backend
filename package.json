{
	"name": "Telemetry-PWA-backend",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"dev": "tsx --watch --env-file .env src/index.ts",
		"start": "node --env-file .env dist/index.js",
		"build": "tsc",
		"type-check": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "echo \"Error: no test specified\" && exit 1",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint",
			"prettier --check"
		],
		"*.{json,yml,yaml,md}": [
			"prettier --check"
		]
	},
	"keywords": [],
	"author": "1withspaghetti",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.11.0",
	"dependencies": {
		"express": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"@tsconfig/node22": "^22.0.2",
		"@types/express": "^5.0.3",
		"@types/node": "^24.8.1",
		"eslint": "^9.38.0",
		"eslint-plugin-perfectionist": "^4.15.1",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.4",
		"prettier": "^3.6.2",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1"
	},
	"imports": {
		"#*": "./src/*"
	}
}
